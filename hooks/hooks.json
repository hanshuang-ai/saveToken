{
  "description": "frugal: conservative Bash/Read output views with committed original retrieval",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|Read",
        "hooks": [
          {
            "type": "command",
            "command": "npx --prefix \"${CLAUDE_PLUGIN_ROOT}\" --no-install tsx \"${CLAUDE_PLUGIN_ROOT}/hooks/post-tool-compress.ts\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
