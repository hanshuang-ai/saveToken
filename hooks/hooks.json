{
  "description": "frugal PostToolUse:工具输出分类→无损压缩→updatedToolOutput 替换为压缩版",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|Read",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/post-tool-compress.ts"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
